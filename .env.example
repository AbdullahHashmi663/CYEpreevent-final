# Server-only credentials. Never use a NEXT_PUBLIC prefix for these values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@YOUR_SUPABASE_POOLER:5432/postgres"
DATABASE_CA_FILE="supabase/certs/prod-ca-2021.crt"
ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_16_CHARACTERS"
# Exact website origin. Set to your HTTPS origin in production.
APP_ORIGIN="http://localhost:3000"
# Enable only behind a host that supplies and sanitizes client IP headers.
TRUST_PROXY="false"
# Password-change codes are sent only to this owner-controlled address.
ADMIN_SECURITY_EMAIL="owner@example.com"
RESEND_API_KEY=""
EMAIL_FROM="Capital Youth Expo <security@YOUR_VERIFIED_DOMAIN>"
# Official CYE competition integration; server-only, never expose in browser code.
CYE_PARTNER_API_KEY=""

# Optional Google Search Console HTML verification value (not an API key).
GOOGLE_SITE_VERIFICATION=""

# Shared rate limiting; server-only. Use rediss:// when TLS is enabled by your provider.
REDIS_URL="redis://default:REPLACE_WITH_REDIS_PASSWORD@YOUR_REDIS_HOST:6379"
# Optional namespace override; defaults to a separate production/preview/development prefix.
REDIS_KEY_PREFIX=""
